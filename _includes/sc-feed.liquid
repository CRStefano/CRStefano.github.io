{%- comment -%}
  Elenco a scorrimento verticale per Articles e Blog (stessa struttura per entrambe).
    include.items  elenco di voci (_data/articles.yml o _data/blog.yml)
    include.label  nome al plurale per i messaggi ("articles", "posts")
    include.taglist elenco dei tag ammessi (_data/tags.yml oppure _data/work_tags.yml)
    include.datefmt formato della data (es. '%-d %b %Y' oppure solo l'anno '%Y')
  Ordine delle voci: dal piu' recente. Ordine dei pulsanti-tag: dal piu' usato al meno usato
  (a parita' resta l'ordine del file dei tag). Ricerca e filtri: assets/js/sc-feed.js.
  Ogni voce porta nei data-* i testi su cui cerca lo script; senza JavaScript
  l'elenco resta comunque leggibile e cliccabile.
{%- endcomment -%}
{%- if include.items -%}
  {%- assign items = include.items | sort: 'date' | reverse -%}
{%- else -%}
  {%- assign items = '' | split: '' -%}
{%- endif -%}
{%- assign label = include.label | default: 'items' -%}
{%- assign taglist = include.taglist | default: site.data.tags -%}
{%- assign datefmt = include.datefmt | default: '%-d %b %Y' -%}

{%- comment -%}
  Pulsanti-tag in ordine di utilizzo. Per ogni tag usato costruisco una chiave numerica
  con 7 cifre fisse: 1.000.000 + (voci * 1000) + (999 - posizione nel file dei tag).
  Ordinandole al contrario vengono prima i tag con piu' voci e, a parita', il primo del file.
{%- endcomment -%}
{%- assign tagkeys = '' | split: '' -%}
{%- for t in taglist -%}
  {%- assign used = items | where_exp: 'i', 'i.tags contains t.id' -%}
  {%- if used.size > 0 -%}
    {%- assign key = used.size | times: 1000 | plus: 999 | minus: forloop.index0 | plus: 1000000 | append: '' | split: ',' -%}
    {%- assign tagkeys = tagkeys | concat: key -%}
  {%- endif -%}
{%- endfor -%}
{%- assign tagkeys = tagkeys | sort | reverse -%}

<div class="feed-wrap" data-feed data-label="{{ label }}">
  {%- if items.size > 0 %}
    <div class="feed-tools">
      <div class="feed-search" role="search">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <circle cx="10.5" cy="10.5" r="6.8"/><path d="M15.6 15.6 21 21"/>
        </svg>
        <input type="search" class="feed-q" placeholder="Search by keyword or tag…" aria-label="Search {{ label }}" autocomplete="off" spellcheck="false">
        <button type="button" class="feed-clear" hidden>Clear</button>
      </div>

      <div class="feed-tags" aria-label="Filter by tag">
        {%- for k in tagkeys -%}
          {%- assign num = k | minus: 1000000 -%}
          {%- assign rest = num | modulo: 1000 -%}
          {%- assign pos = 999 | minus: rest -%}
          {%- assign n = num | divided_by: 1000 -%}
          {%- assign t = taglist[pos] %}
          <button type="button" class="tag-chip" data-tag="{{ t.id }}" aria-pressed="false">{{ t.label }} <span class="n">{{ n }}</span></button>
        {%- endfor %}
      </div>
      <p class="feed-status" aria-live="polite"></p>
    </div>

    <ol class="feed-list">
      {%- for it in items -%}
        {%- capture tagtext -%}
          {%- for tid in it.tags -%}
            {%- assign t = taglist | where: 'id', tid | first -%}
            {{ tid }} {{ t.label }} {{ t.aliases | join: ' ' }}{% unless forloop.last %}{{ ' ' }}{% endunless %}
          {%- endfor -%}
        {%- endcapture %}
        <li class="feed-item" data-date="{{ it.date | date: '%Y-%m-%d' }}" data-tags="{{ it.tags | join: ' ' }}" data-tagtext="{{ tagtext | strip | escape }}">
          <span class="feed-date"><time datetime="{{ it.date | date: '%Y-%m-%d' }}">{{ it.date | date: datefmt | downcase }}</time>{% if it.where %} · {{ it.where }}{% endif %}</span>
          {%- if it.url %}
          <h2 class="feed-title"><a href="{{ it.url }}" target="_blank" rel="noopener">{{ it.title }}</a></h2>
          {%- else %}
          <h2 class="feed-title"><a>{{ it.title }}</a></h2>
          {%- endif %}
          {%- if it.summary %}
            <p class="feed-summary">{{ it.summary }}</p>
          {%- endif %}
          {%- if it.tags and it.tags.size > 0 %}
            <div class="feed-tags">
              {%- for tid in it.tags -%}
                {%- assign t = taglist | where: 'id', tid | first %}
                <button type="button" class="tag-chip" data-tag="{{ tid }}" aria-pressed="false">{{ t.label | default: tid }}</button>
              {%- endfor %}
            </div>
          {%- endif %}
        </li>
      {%- endfor %}
    </ol>
    <p class="feed-empty" hidden>Nothing found. Try another word or remove a tag.</p>
  {%- else %}
    <p class="feed-empty">No {{ label }} yet.</p>
  {%- endif %}
</div>
