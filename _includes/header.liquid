{%- comment -%}
  Header di Stefano (sostituisce quello del tema al_folio_core).
  Perche' e' locale: nel sito Canva il menu ha sempre 4 voci in fila + interruttore,
  senza nome, hamburger, sottomenu, ricerca o barra di avanzamento. Nel tema quegli
  elementi sono nascosti con regole !important dentro un cascade layer che il CSS del
  sito non puo' battere: piu' semplice e robusto avere un header proprio.

  Le voci di menu sono le pagine con `nav: true` nel front matter (ordine: `nav_order`),
  piu' la Home (la pagina con permalink "/").
  Il pulsante #light-toggle e' richiesto da assets/js/theme.js.
{%- endcomment -%}
<header>
  <nav id="navbar" class="navbar navbar-light" role="navigation" aria-label="Main navigation">
    <div class="container">
      <ul class="navbar-nav navbar-menu-list">
        {%- assign about_page = site.pages | where: "permalink", "/" | first -%}
        <li class="nav-item{% if page.permalink == '/' %} active{% endif %}">
          <a class="nav-link" href="{{ '/' | relative_url }}"{% if page.permalink == '/' %} aria-current="page"{% endif %}>{{ about_page.title | default: 'home' }}</a>
        </li>
        {%- assign sorted_pages = site.pages | sort: "nav_order" -%}
        {%- for p in sorted_pages -%}
          {%- if p.nav and p.autogen == null -%}
            {%- assign parent_link = p.permalink | remove: "index.html" -%}
            <li class="nav-item{% if page.url contains parent_link %} active{% endif %}">
              <a class="nav-link" href="{{ p.url | relative_url }}"{% if page.url contains parent_link %} aria-current="page"{% endif %}>{{ p.title }}</a>
            </li>
          {%- endif -%}
        {%- endfor -%}
        {%- if site.enable_darkmode -%}
          <li class="toggle-container">
            <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme"></button>
          </li>
        {%- endif -%}
      </ul>
    </div>
  </nav>
</header>
