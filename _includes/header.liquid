{%- comment -%}
  Header di Stefano (sostituisce quello del tema al_folio_core).
  Come su Canva il menu e' UNA riga di testo: "HOME - WORKS - ARTICLES - BLOG - CONTACT"
  piu' l'interruttore chiaro/scuro. Niente classi "navbar"/"nav-link" del tema:
  cosi' nessuna regola del tema puo' spostare o ridisegnare il menu.

  Le voci sono la Home (permalink "/") + le pagine con `nav: true` nel front matter,
  in ordine di `nav_order`. Ogni voce tranne l'ultima tiene uno spazio finale dentro
  il link: su Canva la sottolineatura della voce attiva si allunga su quello spazio.
  Il pulsante #light-toggle e' richiesto da assets/js/theme.js.
{%- endcomment -%}
{%- assign about_page = site.pages | where: "permalink", "/" | first -%}
{%- assign sorted_pages = site.pages | where: "nav", true | sort: "nav_order" -%}
<header class="sc-header">
  <nav class="sc-nav" aria-label="Main navigation">
    <ul class="sc-menu">
      {%- assign is_home = false -%}
      {%- if page.permalink == '/' -%}{%- assign is_home = true -%}{%- endif -%}
      <li{% if is_home %} class="active"{% endif %}><a href="{{ '/' | relative_url }}"{% if is_home %} aria-current="page"{% endif %}>{{ about_page.title | default: 'home' }} </a></li>
      {%- for p in sorted_pages -%}
        {%- if p.autogen == null -%}
          {%- assign parent_link = p.permalink | remove: 'index.html' -%}
          {%- assign is_active = false -%}
          {%- if page.url contains parent_link -%}{%- assign is_active = true -%}{%- endif -%}
          <li{% if is_active %} class="active"{% endif %}>- <a href="{{ p.url | relative_url }}"{% if is_active %} aria-current="page"{% endif %}>{{ p.title }}{% unless forloop.last %}{{ ' ' }}{% endunless %}</a></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if site.enable_darkmode %}
      <button id="light-toggle" class="sc-toggle" type="button" title="Change theme" aria-label="Change color theme"></button>
    {%- endif %}
  </nav>
</header>
