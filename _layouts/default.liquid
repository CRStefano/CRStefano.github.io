<!doctype html>
{%- comment -%}
  al_rtl owns the language and direction attributes when it is installed, because
  `dir` has to sit on <html> for the browser's bidi handling, CSS logical
  properties and Tailwind's rtl: variant to apply to the whole document.

  Captured into a variable rather than wrapping the <html> tag in a conditional:
  a conditional there stops the tag being a single static element, and Prettier
  then re-indents the entire document body. The guard keeps this parse-safe —
  without the plugin the tag does not exist and Liquid fails on every page.
{%- endcomment -%}
{%- capture html_attributes -%}
  {%- if site.plugins contains 'al_rtl' -%}
    {%- include plugins/al_rtl_html_attrs.liquid -%}
  {%- else -%}
    lang="{{ site.lang }}"
  {%- endif -%}
{%- endcapture -%}
<html {{ html_attributes }}>
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
  </head>

  <!-- Body -->
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- ========================================================================
         SFONDO (personalizzazione di Stefano - vedi _sass/_stefano.scss)
         Strati decorativi indipendenti, ognuno ancorato a un bordo della pagina e
         dimensionato in vw: si adattano a qualsiasi schermo. La sfumatura verso
         l'interno e' nel canale alpha delle immagini, cosi' la grana resta continua.
         ======================================================================== -->
    <div class="bg-base" aria-hidden="true" style="--grain-light: url('{{ '/assets/img/bg/grain_light.webp' | relative_url }}'); --grain-dark: url('{{ '/assets/img/bg/grain_dark.webp' | relative_url }}');"></div>
    <div class="deco deco-light d-lt-left" aria-hidden="true" style="--img: url('{{ '/assets/img/bg/lt_left.webp' | relative_url }}'); --ar: 0.4802;"></div>
    <div class="deco deco-light d-lt-right" aria-hidden="true" style="--img: url('{{ '/assets/img/bg/lt_right.webp' | relative_url }}'); --ar: 0.6716;"></div>
    <div class="deco deco-light d-bottom d-lb-right" aria-hidden="true" style="--img: url('{{ '/assets/img/bg/lb_right.webp' | relative_url }}'); --ar: 1.0118;"></div>
    <div class="deco deco-dark d-dt-band" aria-hidden="true" style="--img: url('{{ '/assets/img/bg/dt_band.webp' | relative_url }}'); --ar: 2.8761;"></div>
    <div class="deco deco-dark d-bottom d-db-trees" aria-hidden="true" style="--img: url('{{ '/assets/img/bg/db_trees.webp' | relative_url }}'); --ar: 3.4392;"></div>

    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="container mt-5" role="main">
      {% if page.toc and page.toc.sidebar %}
        {% assign toc_collapse = page.toc.collapse | default: 'expanded' %}
        {% assign toc_collapse_depth = page.toc.collapse_depth | default: '' %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row">
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav
                id="toc-sidebar"
                class="sticky-top toc toc-sidebar"
                aria-label="Table of contents"
                data-toc-collapse="{{ toc_collapse }}"
                data-toc-collapse-depth="{{ toc_collapse_depth }}"
              ></nav>
            </div>
          </div>
        {% else %}
          <div class="row">
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav
                id="toc-sidebar"
                class="sticky-top toc toc-sidebar"
                aria-label="Table of contents"
                data-toc-collapse="{{ toc_collapse }}"
                data-toc-collapse-depth="{{ toc_collapse_depth }}"
              ></nav>
            </div>
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}
      {% endif %}
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}

    <!-- Decorazioni ancorate in basso: compaiono solo se la pagina e' piu' alta dello schermo -->
    <script>
      (function () {
        var b = document.body;
        function fit() { b.classList.toggle("has-bottom", b.scrollHeight > window.innerHeight * 1.15); }
        window.addEventListener("resize", fit);
        window.addEventListener("load", fit);
        fit();
      })();
    </script>
  </body>
</html>
