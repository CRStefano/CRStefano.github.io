---
layout: default
---
<div class="home">
  <section class="hero">
    <div class="intro">
      <h1 class="home-name">{{ site.first_name }} {{ site.last_name }}</h1>
      {{ content }}
    </div>
    {% if page.photo %}
      <img
        class="photo"
        src="{{ page.photo | prepend: '/assets/img/' | relative_url }}"
        alt="{{ site.first_name }} {{ site.last_name }}"
        width="420"
        height="420"
        loading="eager"
        decoding="async"
      >
    {% endif %}
  </section>

  <section class="edu" aria-label="Education and certification">
    <div>
      <h2 class="edu-title">Education &amp; Certification</h2>
    </div>
    <div class="edu-list">
      {% for e in site.data.education %}
        <div class="entry">
          <h3>{{ e.title }}</h3>
          <p>
            {%- for l in e.lines -%}
              {{ l }}{% unless forloop.last %}<br>{% endunless %}
            {%- endfor -%}
          </p>
        </div>
      {% endfor %}
    </div>
  </section>
</div>
