---
layout: default
---
{%- comment -%}
  Home: due "diapositive" come su Canva.
    1) nome, presentazione (testo della pagina _pages/about.md) e foto
    2) Education & Certification (voci in _data/education.yml)
  Le posizioni sul desktop sono in _sass/_stefano.scss (sezione 7).
{%- endcomment -%}
<div class="home">
  <section class="slide s-hero">
    <h1 class="home-name">{{ site.first_name }}<br class="br-d"> {{ site.last_name }}</h1>
    <div class="intro">
      {{ content }}
    </div>
    {% if page.photo %}
      <img
        class="photo"
        src="{{ page.photo | prepend: '/assets/img/' | relative_url }}"
        alt="{{ site.first_name }} {{ site.last_name }}"
        width="464"
        height="464"
        loading="eager"
        decoding="async"
      >
    {% endif %}
  </section>

  <section class="slide s-edu" aria-label="Education and certification">
    <h2 class="edu-title">Education &amp;<br class="br-d"> Certification</h2>
    {%- comment -%} con 3 voci (come su Canva) ognuna va al suo posto esatto; con un numero diverso le voci si impilano {%- endcomment -%}
    <div class="edu-list{% if site.data.education.size == 3 %} canva{% endif %}">
      {% for e in site.data.education %}
        <div class="entry">
          <h3>{{ e.title }}</h3>
          <p>
            {%- for l in e.lines -%}
              {{ l }}{% unless forloop.last %}<br>{% endunless %}
            {%- endfor -%}
          </p>
        </div>
      {% endfor %}
    </div>
  </section>
</div>
{%- comment -%}
  Dati strutturati per Google (non si vedono): chi sei, di cosa ti occupi, dove sono i tuoi profili.
  I valori sono in _data/seo.yml. Il nome viene da first_name / last_name di _config.yml.
{%- endcomment -%}
{%- capture seo_author -%}{{ site.first_name }} {{ site.last_name }}{%- endcapture -%}
{%- assign seo = site.data.seo -%}
{%- assign seo_home = '/' | absolute_url -%}
{%- assign seo_img = site.og_image | default: '/assets/img/og-image.png' | absolute_url -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": {{ seo_home | append: '#person' | jsonify }},
      "name": {{ seo_author | jsonify }},
      "givenName": {{ site.first_name | jsonify }},
      "familyName": {{ site.last_name | jsonify }},
      "url": {{ seo_home | jsonify }},
      "image": {{ seo_img | jsonify }},
      "description": {{ page.description | default: site.description | jsonify }}
      {%- if seo.job_title -%}, "jobTitle": {{ seo.job_title | jsonify }}{%- endif -%}
      {%- if seo.alumni_of -%}, "alumniOf": { "@type": "CollegeOrUniversity", "name": {{ seo.alumni_of.name | jsonify }}, "url": {{ seo.alumni_of.url | jsonify }} }{%- endif -%}
      {%- if seo.knows_about -%}, "knowsAbout": {{ seo.knows_about | jsonify }}{%- endif -%}
      {%- if seo.same_as -%}, "sameAs": {{ seo.same_as | jsonify }}{%- endif -%}
    },
    {
      "@type": "WebSite",
      "@id": {{ seo_home | append: '#website' | jsonify }},
      "url": {{ seo_home | jsonify }},
      "name": {{ seo_author | jsonify }},
      "inLanguage": {{ site.lang | jsonify }},
      "publisher": { "@id": {{ seo_home | append: '#person' | jsonify }} }
    }
  ]
}
</script>
